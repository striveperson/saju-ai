{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm exec oxfmt:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm build:spa)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm --filter web dev)",
      "Bash(pnpm --filter web build)",
      "Bash(pnpm --filter web lint)",
      "Bash(pnpm --filter web test:*)",
      "Bash(pnpm --filter web generate-routes)",
      "Bash(pnpm --filter web typecheck)",
      "Bash(pnpm --filter web exec tsc:*)",
      "Bash(pnpm --filter web exec oxlint:*)",
      "Bash(pnpm --filter web exec vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)"
    ],
    "ask": ["Bash(git commit:*)", "Bash(git push:*)"],
    "deny": [
      "Read(./**/.env*)",
      "Edit(./**/.env*)",
      "Write(./**/.env*)",
      "Read(./**/.claude/settings.local.json)",
      "Edit(./**/.claude/settings.local.json)",
      "Write(./**/.claude/settings.local.json)",
      "Edit(./apps/web/src/routeTree.gen.ts)",
      "Write(./apps/web/src/routeTree.gen.ts)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      }
    ]
  }
}
